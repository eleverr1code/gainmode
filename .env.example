# Переменные окружения для работы заказов через Telegram-бота.
# Скопируйте в .env.local и заполните своими значениями (.env.local не коммитится).

# Токен бота, полученный от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=
# chat_id менеджера или группы, куда бот будет присылать заказы
TELEGRAM_CHAT_ID=
